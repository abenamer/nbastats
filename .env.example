# Copy to .env and fill in the values. Never commit a real .env file.
# Every variable the application and the Compose file read, grouped by purpose, with its
# default where one exists. Secrets are left empty. See docs/reference/configuration.md.

# --- Database (Compose creates the PostgreSQL service with these) ---
POSTGRES_USER=nba
POSTGRES_PASSWORD=
POSTGRES_DB=nba
# Compose builds DATABASE_URL from the three values above. Set it only for a run outside
# Docker (see docs/runbooks/develop.md), for example:
# DATABASE_URL=postgres://nba:<password>@127.0.0.1:5432/nba
DB_MAX_CONNECTIONS=8
DB_CONNECT_TIMEOUT_SECS=120

# --- Network ---
# Host interface and port the dashboard is published on (loopback only by default).
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=3000
# Address the server listens on inside the container.
APP_BIND=0.0.0.0:3000
# Host names the server accepts in the Host header. Add your LAN name if you publish the port.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Data ---
APP_DATA_DIR=/var/lib/nba-app
AUTO_IMPORT_BUNDLED=true
BUNDLED_DATASET=/app/data/nba_elo_neil_paine.csv.gz
DATA_SOURCE_URL=https://raw.githubusercontent.com/Neil-Paine-1/NBA-elo/master/nba_elo.csv

# --- Simulation limits ---
MAX_ITERATIONS=5000000
# Estimated work budget of one job (draws x per-draw work); protects the CPU from runaway requests.
MAX_WORK_UNITS=4000000000
# Rayon thread count; default: number of CPUs.
SIM_THREADS=

# --- Results sync (BALLDONTLIE, https://www.balldontlie.io; the free tier is enough for
# results; box scores, rosters and injury reports need the ALL-STAR tier) ---
# Leave the key empty to disable the sync, the daily refresh and the player data.
BALLDONTLIE_API_KEY=
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/v1
# Requests per minute allowed by your plan (free: 5, ALL-STAR: 60, GOAT: 600).
BALLDONTLIE_REQUESTS_PER_MINUTE=5
# Daily sync of the current season (needs the key). Time is HH:MM in the IANA zone.
RESULTS_SYNC_ENABLED=true
RESULTS_SYNC_TIME=04:00
RESULTS_SYNC_TIMEZONE=America/New_York
# After the daily results sync, fetch the season's box scores and today's injury report.
PLAYER_SYNC_ENABLED=true
# Backfill the box scores of every season from this end year on, in the background, until
# nothing is left (1947 for every season). Leave empty to backfill by hand from the Data page.
PLAYER_BACKFILL_FROM=

# --- Question box (OpenRouter, https://openrouter.ai/keys) ---
# Leave the key empty to keep the box off. The question and the data the model asks for are
# sent to OpenRouter and the model's provider. Set a spending limit on the key.
OPENROUTER_API_KEY=
# Any OpenRouter model with tool calling; a small, cheap model is enough for lookups.
# Add ":floor" for the cheapest provider of that model.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Another OpenAI-compatible chat API (for example a local Ollama at http://host.docker.internal:11434/v1).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Key rotation: a management key (https://openrouter.ai/settings/management-keys) lets the
# application mint its own completion key at start, replace it every OPENROUTER_KEY_ROTATION_HOURS
# and when the service refuses it, and delete the keys it minted before. With it, OPENROUTER_API_KEY
# may stay empty. The management key can spend the account: keep it as safe as a password.
OPENROUTER_MANAGEMENT_KEY=
# Spending limit, in credits, on each minted key (empty: none). Bounds what a leaked key is worth.
OPENROUTER_KEY_LIMIT=
OPENROUTER_KEY_ROTATION_HOURS=24
# The name prefix of the minted keys. Two instances sharing one management key need two.
OPENROUTER_KEY_NAME=nba-elo-simulator

# --- Game reports (links to the AP game reports that ESPN hosts) ---
# The Records page asks ESPN's public scoreboard feed, one date at a time, for the games it
# shows and keeps the links. Only dates are sent. Set to false to make no such requests.
# Without an Odds API key, the feed is also where the Tonight panel's sportsbook lines
# (DraftKings) come from.
GAME_REPORTS_ENABLED=true
ESPN_BASE_URL=https://site.api.espn.com

# --- Market lines from The Odds API (the-odds-api.com) ---
# Leave the key empty to read the lines from ESPN's scoreboard instead. With a key, the
# Tonight panel and the market tracking read the chosen sportsbook's moneylines, spreads and
# totals from the service, and fall back to ESPN when a read fails. Each read costs three of
# the plan's credits (one per market); on a game day the tracking reads once when the date
# comes, Eastern time, and once in the last eleven minutes before each tip-off time: about
# 20 credits a night, 550 to 600 a month in season, which the free 500 do not quite cover
# and the smallest paid plan does. Only dates and the sportsbook are sent, with the key, in
# the request.
ODDS_API_KEY=
# The sportsbook's key at the service: fanduel, draftkings, betmgm, caesars, ...
ODDS_API_BOOKMAKER=fanduel
ODDS_API_BASE_URL=https://api.the-odds-api.com

# --- Logging ---
RUST_LOG=info,sqlx=warn
# "json" gives structured JSON lines.
LOG_FORMAT=text
